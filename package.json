{
  "name": "cloaksift",
  "version": "0.5.0",
  "description": "Offline CLI for local secret and PII review, directory scans and staged Git checks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cloaksift": "./dist/cli.js",
    "cloak-sift": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "START-HERE-AR.md",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MalekMahmouda/cloaksift.git"
  },
  "keywords": [
    "cli",
    "offline",
    "secrets",
    "redaction",
    "privacy",
    "sarif",
    "typescript"
  ]
}
